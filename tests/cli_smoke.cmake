set(expected 2)
set(pattern "Usage:")
if(MODE STREQUAL "self-test")
  set(args --self-test)
  set(expected 0)
  set(pattern "self-test: passed")
elseif(MODE STREQUAL "list-devices")
  set(args --list-devices)
  set(expected 0)
  set(pattern "Input endpoints:")
elseif(MODE STREQUAL "invalid")
  set(args --unknown)
elseif(MODE STREQUAL "missing-endpoints")
  set(args --probe)
elseif(MODE STREQUAL "invalid-endpoints")
  set(args --probe --input-id nonexistent-input --output-id nonexistent-output --duration-ms 250)
  set(expected 3)
  set(pattern "Probe failed.*stage=initialize.*HRESULT=0x")
elseif(MODE STREQUAL "invalid-duration")
  set(args --probe --input-id x --output-id y --duration-ms -1)
elseif(MODE STREQUAL "oversized-duration")
  set(args --probe --input-id x --output-id y --duration-ms 5001)
elseif(MODE STREQUAL "duplicate-id")
  set(args --probe --input-id x --input-id z --output-id y)
elseif(MODE STREQUAL "invalid-preset")
  set(args --probe --input-id x --output-id y --preset exclusive)
else()
  message(FATAL_ERROR "Unknown smoke scenario")
endif()
execute_process(COMMAND "${PROGRAM}" ${args} RESULT_VARIABLE code
  OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 8)
message(STATUS "${MODE}: exit=${code}\n${output}${error}")
if(NOT "${code}" STREQUAL "${expected}" OR NOT output MATCHES "${pattern}")
  message(FATAL_ERROR "Unexpected exit or missing CLI output")
endif()
if(MODE STREQUAL "list-devices" AND NOT output MATCHES "Output endpoints:")
  message(FATAL_ERROR "Missing render enumeration")
endif()
if(MODE STREQUAL "invalid-endpoints" AND NOT output MATCHES "actual_period_frames=.*fallback_reason=")
  message(FATAL_ERROR "Missing structured period/fallback diagnostics")
endif()
